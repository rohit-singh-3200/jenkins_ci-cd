pipeline{
    agent any

    stages{
        stage('Checkout'){
            
            steps{

                echo 'Repository cloned successfully!'
            }
        }

        stage('Project Files'){

            steps{

                sh 'pwd'
                sh 'ls -R'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t gallery-app .'
             }
        }

        stage('List Images') {
            steps {
                sh 'docker images'
            }
        }
    }
}